{
  "name": "potato-monorepo",
  "version": "1.0.0",
  "license": "MIT",
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "libs/*",
    "packages/*"
  ],
  "scripts": {
    "check:workspace-deps": "bun run scripts/check-workspace-deps.ts",
    "preinstall": "bun run scripts/check-workspace-deps.ts",
    "dev": "bun --env-file=.env --env-file=.env.local --cwd apps/server dev & bun --env-file=.env --env-file=.env.local --cwd apps/web-app dev & bun --env-file=.env --env-file=.env.local --cwd apps/github-bot dev & bun --env-file=.env --env-file=.env.local --cwd apps/extension dev & wait",
    "start": "bun --env-file=.env --env-file=.env.local --cwd apps/server start & bun --env-file=.env --env-file=.env.local --cwd apps/web-app start & bun --env-file=.env --env-file=.env.local --cwd apps/github-bot start & bun --env-file=.env --env-file=.env.local --cwd apps/extension start & wait",
    "dev:server": "bun --env-file=.env --env-file=.env.local --cwd apps/server dev",
    "start:server": "bun --env-file=.env --env-file=.env.local --cwd apps/server start",
    "dev:web": "bun --env-file=.env --env-file=.env.local --cwd apps/web-app dev",
    "build:web": "bun --env-file=.env --env-file=.env.local --cwd apps/web-app build",
    "dev:bot": "bun --env-file=.env --env-file=.env.local --cwd apps/github-bot dev",
    "start:bot": "bun --env-file=.env --env-file=.env.local --cwd apps/github-bot start",
    "dev:extension": "bun --env-file=.env --env-file=.env.local --cwd apps/extension dev",
    "build:extension": "bun --env-file=.env --env-file=.env.local --cwd apps/extension build",
    "build": "bun --env-file=.env --env-file=.env.local --filter '*' run build",
    "format": "prettier --write ."
  },
  "private": true,
  "devDependencies": {
    "@potatoe/shared": "workspace:*",
    "prettier": "^3.9.6"
  },
  "overrides": {
    "eslint": "^8.57.1",
    "typescript": "~5.8.3"
  },
  "dependencies": {
    "iconsax-reactjs": "^0.0.8"
  }
}
