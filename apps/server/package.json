{
  "name": "@potatoe/server",
  "packageManager": "bun@1.3.10",
  "exports": {
    "./trpc": {
      "types": "./src/trpc/index.ts",
      "default": "./src/trpc/index.ts"
    }
  },
  "scripts": {
    "dev": "bun run db:migrate && bun --env-file=../../.env --env-file=../../.env.local run --hot src/index.ts",
    "start": "bun --env-file=../../.env --env-file=../../.env.local run src/index.ts",
    "start:with-migrations": "bun run db:migrate && bun --env-file=../../.env --env-file=../../.env.local run src/index.ts",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "db:generate": "bun --env-file=../../.env --env-file=../../.env.local x drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env --env-file=../../.env.local run scripts/migrate.ts",
    "push": "bun --env-file=../../.env --env-file=../../.env.local run scripts/push-db.ts",
    "db:studio": "bun --env-file=../../.env --env-file=../../.env.local x drizzle-kit studio",
    "db:push": "bun --env-file=../../.env --env-file=../../.env.local x drizzle-kit push",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hono-dev/auth-github": "^0.0.1",
    "@neondatabase/serverless": "^0.10.4",
    "@potatoe/db": "workspace:*",
    "@potatoe/shared": "workspace:*",
    "@trpc/server": "^11.18.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.0",
    "hono": "^4.7.2",
    "pg": "^8.14.0",
    "prettier": "^3.5.3",
    "resend": "^6.9.4",
    "telegraf": "^4.16.3",
    "telegramify-markdown": "^1.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.5",
    "typescript": "~5.8.3",
    "tsx": "^4.19.3"
  }
}
